<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Ko'p-maqsadli (multi-target) loyiha:
      net46            -> AutoCAD 2018, 2020, 2021, 2024, AutoCAD Mechanical 2021 (.NET Framework)
      net8.0-windows   -> AutoCAD 2025 (.NET 8)

    Moslik qoidasi: .NET Framework DLL eng ESKI versiya (2018) API'siga qarshi
    qurilsa, u 2018-2024 (va Mechanical 2021) da ishlaydi (forward-compatible).
    2025 alohida .NET 8 DLL talab qiladi.

    Build:
      dotnet build -c Release
    yoki AcadDir'larni override qilib:
      dotnet build -c Release -p:AcadDir="C:\Program Files\Autodesk\AutoCAD 2018\" -p:AcadDir2025="C:\Program Files\Autodesk\AutoCAD 2025\"
  -->

  <PropertyGroup>
    <TargetFrameworks>net46;net8.0-windows</TargetFrameworks>
    <AssemblyName>Aktivatsiya</AssemblyName>
    <RootNamespace>Aktivatsiya</RootNamespace>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Configuration Condition="'$(Configuration)'==''">Release</Configuration>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <!-- Manba fayllar -->
  <ItemGroup>
    <Compile Include="RibbonAktivatsiya.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
  </ItemGroup>

  <!-- ================= .NET Framework: AutoCAD 2018/2020/2021/2024 + Mechanical 2021 ================= -->
  <PropertyGroup Condition="'$(TargetFramework)'=='net46'">
    <OutputPath>..\Aktivatsiya.bundle\Contents\acad-net4\</OutputPath>
    <!-- Eng eski qo'llab-quvvatlanadigan AutoCAD DLL'lariga ishora qiling (moslik uchun) -->
    <AcadDir Condition="'$(AcadDir)'==''">C:\Program Files\Autodesk\AutoCAD 2018\</AcadDir>
  </PropertyGroup>
  <ItemGroup Condition="'$(TargetFramework)'=='net46'">
    <!-- WPF (RibbonButton ikonkasi va ICommand uchun) -->
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Xaml" />
    <!-- AutoCAD .NET API (nusxalanmaydi) -->
    <Reference Include="AcCoreMgd"><HintPath>$(AcadDir)accoremgd.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="AcDbMgd"><HintPath>$(AcadDir)acdbmgd.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="AcMgd"><HintPath>$(AcadDir)acmgd.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="AdWindows"><HintPath>$(AcadDir)AdWindows.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <!-- ================= .NET 8: AutoCAD 2025 ================= -->
  <PropertyGroup Condition="'$(TargetFramework)'=='net8.0-windows'">
    <UseWPF>true</UseWPF>
    <OutputPath>..\Aktivatsiya.bundle\Contents\acad-net8\</OutputPath>
    <AcadDir2025 Condition="'$(AcadDir2025)'==''">C:\Program Files\Autodesk\AutoCAD 2025\</AcadDir2025>
  </PropertyGroup>
  <ItemGroup Condition="'$(TargetFramework)'=='net8.0-windows'">
    <Reference Include="AcCoreMgd"><HintPath>$(AcadDir2025)accoremgd.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="AcDbMgd"><HintPath>$(AcadDir2025)acdbmgd.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="AcMgd"><HintPath>$(AcadDir2025)acmgd.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="AdWindows"><HintPath>$(AcadDir2025)AdWindows.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

</Project>
