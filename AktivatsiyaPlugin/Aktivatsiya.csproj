<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Ko'p-maqsadli (multi-target) plagin:
      net48           -> AutoCAD 2018, 2020, 2021, 2024, AutoCAD Mechanical 2021 (.NET Framework)
      net8.0-windows  -> AutoCAD 2025 (.NET 8)

    MUHIM: bu loyiha AutoCAD kutubxonalarini (accoremgd.dll, acmgd.dll, acdbmgd.dll,
    AdWindows.dll) O'RNATILGAN AutoCAD papkasidan oladi. Quyida ular AVTOMATIK topiladi.
    Agar sizda AutoCAD boshqa joyda bo'lsa yoki topilmasa, yo'lni qo'lda bering:

      dotnet build -c Release -p:AcadDir="D:\Autodesk\AutoCAD 2022\"
      dotnet build -c Release -p:AcadDir2025="D:\Autodesk\AutoCAD 2025\"

    Faqat mavjud versiyalar uchun build bo'ladi (masalan faqat 2025 bo'lsa — faqat net8).
  -->

  <PropertyGroup>
    <_AcadRoot>C:\Program Files\Autodesk\</_AcadRoot>

    <!-- .NET Framework (net48) uchun: eng ESKI o'rnatilgan AutoCAD'ni tanlaymiz (moslik uchun) -->
    <AcadDir Condition="'$(AcadDir)'=='' and Exists('$(_AcadRoot)AutoCAD 2018\accoremgd.dll')">$(_AcadRoot)AutoCAD 2018\</AcadDir>
    <AcadDir Condition="'$(AcadDir)'=='' and Exists('$(_AcadRoot)AutoCAD 2019\accoremgd.dll')">$(_AcadRoot)AutoCAD 2019\</AcadDir>
    <AcadDir Condition="'$(AcadDir)'=='' and Exists('$(_AcadRoot)AutoCAD 2020\accoremgd.dll')">$(_AcadRoot)AutoCAD 2020\</AcadDir>
    <AcadDir Condition="'$(AcadDir)'=='' and Exists('$(_AcadRoot)AutoCAD 2021\accoremgd.dll')">$(_AcadRoot)AutoCAD 2021\</AcadDir>
    <AcadDir Condition="'$(AcadDir)'=='' and Exists('$(_AcadRoot)AutoCAD 2022\accoremgd.dll')">$(_AcadRoot)AutoCAD 2022\</AcadDir>
    <AcadDir Condition="'$(AcadDir)'=='' and Exists('$(_AcadRoot)AutoCAD 2023\accoremgd.dll')">$(_AcadRoot)AutoCAD 2023\</AcadDir>
    <AcadDir Condition="'$(AcadDir)'=='' and Exists('$(_AcadRoot)AutoCAD 2024\accoremgd.dll')">$(_AcadRoot)AutoCAD 2024\</AcadDir>

    <!-- .NET 8 (net8.0-windows) uchun: AutoCAD 2025+ -->
    <AcadDir2025 Condition="'$(AcadDir2025)'=='' and Exists('$(_AcadRoot)AutoCAD 2025\accoremgd.dll')">$(_AcadRoot)AutoCAD 2025\</AcadDir2025>
    <AcadDir2025 Condition="'$(AcadDir2025)'=='' and Exists('$(_AcadRoot)AutoCAD 2026\accoremgd.dll')">$(_AcadRoot)AutoCAD 2026\</AcadDir2025>

    <!-- Faqat mavjud versiyalar uchun target tanlaymiz -->
    <TargetFrameworks Condition="'$(AcadDir)'!=''">net48</TargetFrameworks>
    <TargetFrameworks Condition="'$(AcadDir2025)'!='' and '$(TargetFrameworks)'!=''">net48;net8.0-windows</TargetFrameworks>
    <TargetFrameworks Condition="'$(AcadDir2025)'!='' and '$(TargetFrameworks)'==''">net8.0-windows</TargetFrameworks>
    <!-- Hech biri topilmasa: net48 (AcadDir ni qo'lda bering) -->
    <TargetFrameworks Condition="'$(TargetFrameworks)'==''">net48</TargetFrameworks>

    <AssemblyName>Aktivatsiya</AssemblyName>
    <RootNamespace>Aktivatsiya</RootNamespace>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Configuration Condition="'$(Configuration)'==''">Release</Configuration>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Deterministic>true</Deterministic>
    <!-- NuGet zaifliklarni tekshirishni o'chiramiz (timeout muammosining oldini oladi) -->
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>

  <!-- Manba fayllar -->
  <ItemGroup>
    <Compile Include="RibbonAktivatsiya.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
  </ItemGroup>

  <!-- ===== .NET Framework: AutoCAD 2018/2020/2021/2024 + Mechanical 2021 ===== -->
  <PropertyGroup Condition="'$(TargetFramework)'=='net48'">
    <OutputPath>..\Aktivatsiya.bundle\Contents\acad-net4\</OutputPath>
  </PropertyGroup>
  <ItemGroup Condition="'$(TargetFramework)'=='net48'">
    <!-- WPF (RibbonButton ikonkasi va ICommand uchun) -->
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Xaml" />
    <!-- AutoCAD .NET API (nusxalanmaydi) -->
    <Reference Include="AcCoreMgd"><HintPath>$(AcadDir)accoremgd.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="AcDbMgd"><HintPath>$(AcadDir)acdbmgd.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="AcMgd"><HintPath>$(AcadDir)acmgd.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="AdWindows"><HintPath>$(AcadDir)AdWindows.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <!-- ===== .NET 8: AutoCAD 2025 ===== -->
  <PropertyGroup Condition="'$(TargetFramework)'=='net8.0-windows'">
    <UseWPF>true</UseWPF>
    <OutputPath>..\Aktivatsiya.bundle\Contents\acad-net8\</OutputPath>
  </PropertyGroup>
  <ItemGroup Condition="'$(TargetFramework)'=='net8.0-windows'">
    <Reference Include="AcCoreMgd"><HintPath>$(AcadDir2025)accoremgd.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="AcDbMgd"><HintPath>$(AcadDir2025)acdbmgd.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="AcMgd"><HintPath>$(AcadDir2025)acmgd.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="AdWindows"><HintPath>$(AcadDir2025)AdWindows.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

</Project>
